<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Simulation Ros2_control tells ros what commands can be sent and what state can be read-->
    <ros2_control name="GazeboSystem" type="system">

        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="omni_wheel_joint_1">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position"></state_interface>
            <state_interface name="velocity"></state_interface>
        </joint>

        <joint name="omni_wheel_joint_2">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position"></state_interface>
            <state_interface name="velocity"></state_interface>
        </joint>

        <joint name="omni_wheel_joint_3">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position"></state_interface>
            <state_interface name="velocity"></state_interface>
        </joint>

    </ros2_control>
</robot>