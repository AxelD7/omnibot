<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omnibot_description</name>
  <version>0.0.0</version>
  <description>Contains the robot description files to define the physical aspect of the robot.</description>
  <maintainer email="axeldejesus120@gmail.com">axel</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- Our urdf's utilize these to do our omniwheel drive and xacro(urdf combiner). -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
